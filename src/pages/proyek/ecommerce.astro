---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
---

<Layout title="Website E-commerce - Proyek Raynaldo">
    <div class="project-container">
        <h1>Website E-commerce</h1>
        <div class="project-image">
             <Image 
                src="https://images.unsplash.com/photo-1551650975-87deedd944c3?ixlib=rb-4.0.3&auto=format&fit=crop&w=1674&q=80" 
                alt="Website E-commerce"
                inferSize={true}
                class="detail-image"
            />
        </div>
        <p>Website e-commerce ini dirancang untuk memudahkan pengguna dalam membeli produk secara online dengan fitur lengkap.</p>
        <ul>
            <li>Manajemen produk dan kategori</li>
            <li>Sistem pembayaran online dan integrasi e-wallet</li>
            <li>Dashboard admin untuk monitoring penjualan</li>
            <li>Desain responsif agar nyaman di desktop dan mobile</li>
        </ul>
        <a href="/" class="back-btn">← Kembali ke Proyek</a>
    </div>
</Layout>

<style>
    /* Scoped styles from the original HTML file's <style> block */
    .project-container {
        max-width: 900px;
        margin: auto;
        padding: 2rem;
        /* Body padding from original is handled here or global, but let's keep it consistent */
        padding-top: 100px; /* added spacing for fixed header */
        min-height: 100vh;
    }
    .project-image img {
        width: 100%;
        border-radius: 10px;
        margin-bottom: 1.5rem;
    }
    h1 {
        font-size: 2rem;
        color: #fff;
        margin-bottom: 1rem;
    }
    p, li {
        font-size: 1rem;
        line-height: 1.6;
        color: #ccc;
    }
    ul {
        padding-left: 1.2rem;
        margin-bottom: 2rem;
    }
    .back-btn {
        display: inline-block;
        padding: 10px 20px;
        background-color: #6C63FF;
        color: #fff;
        border-radius: 6px;
        transition: 0.3s;
        text-decoration: none;
        font-weight: 600;
    }
    .back-btn:hover {
        background-color: #7c75ff;
    }
</style>
