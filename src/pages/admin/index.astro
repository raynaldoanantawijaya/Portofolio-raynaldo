---
import AdminWrapper from '../../components/AdminWrapper';
---

<!doctype html>
<html lang="en" class="h-full dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Panel - CMS</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <!-- Font Awesome for social icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Tailwind Config - Must be BEFORE the CDN script -->
    <script is:inline>
        window.tailwind = {
            config: {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            "primary": "#6C63FF", /* Matching global css */
                            "background-light": "#f6f6f8",
                            "background-dark": "#111111",
                            "card-dark": "#1E1E1E",
                            "charcoal": "#121212",
                            "slate-panel": "#1e1e1e",
                            "editor-paper": "#262626",
                        },
                        fontFamily: {
                            "display": ["Inter", "sans-serif"]
                        },
                    },
                }
            }
        }
    </script>
    <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries,typography"></script>
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Custom scrollbar for admin */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1; 
        }
        ::-webkit-scrollbar-thumb {
            background: #888; 
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #555; 
        }
        .dark ::-webkit-scrollbar-track {
            background: #1e1e1e; 
        }
        .dark ::-webkit-scrollbar-thumb {
            background: #444; 
        }
        /* Prose List Styling Fix - High Specificity */
        .prose ul, .document-canvas ul { 
            list-style-type: disc !important; 
            padding-left: 2rem !important; 
            margin: 1rem 0 !important; 
            list-style-position: inside !important;
        }
        .prose ol, .document-canvas ol { 
            list-style-type: decimal !important; 
            padding-left: 2rem !important; 
            margin: 1rem 0 !important; 
            list-style-position: inside !important;
        }
        .prose li, .document-canvas li { 
            margin: 0.5rem 0 !important; 
            display: list-item !important;
            color: inherit !important;
        }
        .prose li::marker {
            color: #94a3b8 !important; /* slate-400 */
        }
        /* File Input Dark Theme Fix */
        input[type="file"] {
            background-color: #262626 !important;
            border-radius: 0.5rem;
            padding: 0.5rem;
        }
        input[type="file"]::file-selector-button {
            background-color: #6C63FF;
            color: white;
            border: none;
            padding: 0.5rem 1rem;
            border-radius: 9999px;
            font-weight: 600;
            cursor: pointer;
            margin-right: 1rem;
        }
        input[type="file"]::file-selector-button:hover {
            background-color: rgba(108, 99, 255, 0.9);
        }
    </style>
</head>
<body class="bg-[#121212] text-slate-100 h-full">
    <div id="admin-root" class="h-full">
        <AdminWrapper client:only="react" />
    </div>
</body>
</html>
